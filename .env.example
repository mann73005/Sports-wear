# Local development uses a SQLite file created by `npm run setup`.
DATABASE_URL="file:./dev.db"

# For a real deployment, replace the line above with a hosted Postgres URL and
# change `provider` in prisma/schema.prisma to "postgresql".
# See the "Deploying" section of README.md.
# DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
